load("//:CPPVARIABLES.bzl", "DDS_CPPOPTS")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_python//python:packaging.bzl", "py_wheel", "py_wheel_dist")

# The header for :converters_srcs, on an include path a consumer outside
# this package can actually use. The filegroup alone is not enough: an
# extension elsewhere compiles converters.cpp from it (whose own
# `#include "converters.hpp"` resolves next to itself, so that is fine), but
# its own sources have no way to name the header without hardcoding
# //python's directory layout. Headers only, so nothing is compiled or
# exported here and the visibility reasoning below is unaffected.
cc_library(
    name = "converters_hdrs",
    hdrs = ["src/converters.hpp"],
    include_prefix = "dds3",
    strip_include_prefix = "src",
    deps = [
        "//library/src:dds",
    ],
    visibility = ["//visibility:public"],
)

# The Deal-facing converters, exposed as sources rather than as a cc_library
# on purpose. pybind_extension compiles its own srcs with -fvisibility=hidden
# (pybind11_bazel build_defs.bzl); a cc_library dependency would not inherit
# that, so dds3_python's symbols would become exported from every extension
# .so that linked it and could interpose on each other at load time. Listing
# the sources keeps each extension compiling its own hidden-visibility copy.
# Public so an extension outside this repository can reuse them the same way.
filegroup(
    name = "converters_srcs",
    srcs = [
        "src/converters.cpp",
        "src/converters.hpp",
    ],
    visibility = ["//visibility:public"],
)

pybind_extension(
    name = "_dds3",
    srcs = [
        "src/bindings.cpp",
        "src/converters.cpp",
        "src/converters.hpp",
    ],
    copts = DDS_CPPOPTS,
    deps = [
        "//library/src:dds",
        # converters.hpp's own #include <belief_evaluation/evaluate.hpp>,
        # for converters.cpp's evaluation_result_to_dict -- unused here
        # (bindings.cpp never calls it), but converters is one shared file
        # for both extensions, not duplicated, so this extension compiles
        # the same translation unit the other one actually calls it from.
        "//library/src/belief_evaluation",
    ],
    visibility = ["//visibility:public"],
)

# Compile-only: proves bindings.cpp's own include set (mirrored verbatim in
# the one source below, including converters.hpp -- declarations only, never
# called, so converters.cpp need not be a source here too) still compiles
# alongside belief_evaluation's public headers, now that the module is
# namespaced. Not part of the real extension above -- deliberately a
# separate target so a probe never ships in the actual Python package, and
# so this stays easy to remove once the real bindings are written and this
# claim is proven a different way.
pybind_extension(
    name = "_binding_headers_probe",
    testonly = True,
    srcs = [
        "src/binding_headers_probe.cpp",
        "src/converters.hpp",
    ],
    copts = DDS_CPPOPTS,
    deps = [
        "//library/src:dds",
        "//library/src/belief_evaluation",
    ],
    visibility = ["//visibility:private"],
)

pybind_extension(
    name = "_belief_space_local_evaluation",
    srcs = [
        "src/belief_space_local_evaluation.cpp",
        "src/converters.cpp",
        "src/converters.hpp",
    ],
    copts = DDS_CPPOPTS,
    deps = [
        # converters.hpp's own #include <dds/dds.hpp> (needed for the many
        # dds3-specific types its other functions convert) is what pulls
        # this in -- reusing dict_to_deal costs the same dependency dds3's
        # own extension already carries. Distinct from the solver-linked
        # deps just below: this one is the price of one shared converters
        # module rather than a second dict-to-Deal implementation, not
        # about DoubleDummyDefender/Bound at all.
        "//library/src:dds",
        "//library/src/belief_evaluation",
        # The solver seam: DoubleDummyDefender and DoubleDummyBound, both
        # solver-linked (unlike the rest of this extension). SolverContext
        # itself is never registered here -- dds3 keeps that registration
        # (see belief_space_local_evaluation.cpp's own comment on the
        # cross-module pattern) -- so no dep on dds3's own BUILD target is
        # needed for that; these two are what actually need the solver.
        "//library/src/belief_evaluation:double_dummy_bound",
        "//library/src/belief_evaluation:double_dummy_defender",
    ],
    visibility = ["//visibility:public"],
)

# Copy the extension into the dds3 package directory with the platform-specific
# filename Python expects for native modules.
genrule(
    name = "_dds3_in_package_unix",
    srcs = [":_dds3"],
    outs = ["dds3/_dds3.so"],
    cmd = "cp \"$(location :_dds3)\" \"$@\"",
)

genrule(
    name = "_dds3_in_package_windows",
    srcs = [":_dds3"],
    outs = ["dds3/_dds3.pyd"],
    cmd = "cp \"$(location :_dds3)\" \"$@\"",
    cmd_bat = "copy /Y \"$(location :_dds3)\" \"$@\"",
)

alias(
    name = "_dds3_in_package",
    actual = select({
        "//:build_windows": ":_dds3_in_package_windows",
        "//conditions:default": ":_dds3_in_package_unix",
    }),
)

py_library(
    name = "dds3_lib",
    srcs = ["dds3/__init__.py"],
    data = [":_dds3_in_package"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

# Copy the extension into the belief_space_local_evaluation package
# directory with the platform-specific filename Python expects for native
# modules -- mirrors the dds3 genrule pair above exactly.
genrule(
    name = "_belief_space_local_evaluation_in_package_unix",
    srcs = [":_belief_space_local_evaluation"],
    outs = ["belief_space_local_evaluation/_belief_space_local_evaluation.so"],
    cmd = "cp \"$(location :_belief_space_local_evaluation)\" \"$@\"",
)

genrule(
    name = "_belief_space_local_evaluation_in_package_windows",
    srcs = [":_belief_space_local_evaluation"],
    outs = ["belief_space_local_evaluation/_belief_space_local_evaluation.pyd"],
    cmd = "cp \"$(location :_belief_space_local_evaluation)\" \"$@\"",
    cmd_bat = "copy /Y \"$(location :_belief_space_local_evaluation)\" \"$@\"",
)

alias(
    name = "_belief_space_local_evaluation_in_package",
    actual = select({
        "//:build_windows": ":_belief_space_local_evaluation_in_package_windows",
        "//conditions:default": ":_belief_space_local_evaluation_in_package_unix",
    }),
)

py_library(
    name = "belief_space_local_evaluation_lib",
    srcs = ["belief_space_local_evaluation/__init__.py"],
    data = [":_belief_space_local_evaluation_in_package"],
    imports = ["."],
    deps = [":dds3_lib"],
    visibility = ["//visibility:public"],
)

