# One wheel, two top-level imports (dds3 and belief_space_local_evaluation):
# both extensions link the same static library, so two wheels would
# duplicate it on disk and double the install step for a caller who wants
# both. A separate distribution would only earn its keep if this capability
# needed to version independently of dds3, and nothing suggests it will.
py_wheel(
    name = "dds3_wheel",
    distribution = "dds3",
    version = "1.0.0",
    deps = [
        ":belief_space_local_evaluation_lib",
        ":dds3_lib",
        ":_belief_space_local_evaluation_in_package",
        ":_dds3_in_package",
    ],
    strip_path_prefixes = ["python/"],
    entry_points = {},
)

py_wheel_dist(
    name = "dds3_wheel_dist",
    out = "dist",
    wheel = ":dds3_wheel",
)

